rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orman Muhasebe'deki gibi kullanıcı girişi (auth) yok — bu uygulamayı
    // sadece sen kullanacaksın, o yüzden tek belgeye açık erişim yeterli.
    match /app_data/{document=**} {
      allow read, write: if true;
    }
  }
}
